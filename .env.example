# Copie para .env e preencha. O .env nunca vai para o git.

# Banco (usado pelo compose para criar o Postgres e montar a DATABASE_URL)
POSTGRES_USER=mapa365
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=mapa365

# BFF
ALLOWED_ORIGINS=http://localhost:3000
API_URL=http://localhost:3002

# Web (produção): endereço público do BFF. É gravado no build; mudou, rebuild da imagem.
NEXT_PUBLIC_BFF_URL=http://localhost:3001

# --- Produção ---
# Domínio público da API (o registro DNS precisa apontar para o servidor)
API_DOMAIN=api.exemplo.com.br

# --- API (produção) ---
# Pasta do servidor com prompt.md e variables.json (ver docs/conhecimento.md). Padrão: ./knowledge
# KNOWLEDGE_HOST_DIR=/srv/mapa365/knowledge

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v23.0
# Número que recebe o aviso quando alguém pede atendimento humano (com DDI, só dígitos)
HANDOFF_NOTIFY_NUMBER=

# DAILY_MESSAGE_LIMIT=30
